# Copy to .env.local (local) and to Vercel > Settings > Environment Variables (production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# NEW - signs the login cookie. Must be 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# NEW (optional) - shared secret the Raspberry Pi sends as an "x-device-key" header on heartbeats.
DEVICE_API_KEY=

RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
IPROGSMS_API_KEY=
