+    else if (a.style === 'tree') items.push(mkEvac('tree_area', a.label || 'Trees', a.x, a.y, a.w, a.h))
+    else if (a.style === 'building' || a.style === 'gray') items.push(mkEvac('building', a.label || 'Building', a.x, a.y, a.w, a.h))
